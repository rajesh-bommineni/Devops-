<mxfile host="app.diagrams.net">
  <diagram name="Envoy Golden Path - Low-Level Design">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Envoy Golden Path — Low-Level Design (LLD)" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note" value="⚠ Values shown (CIDRs, resource limits, secret names, IAM roles) are illustrative placeholders — replace with actual specs from the design doc." style="text;html=1;fontSize=11;fontStyle=2;fontColor=#b71c1c;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1000" height="20" as="geometry" />
        </mxCell>

        <!-- Client -->
        <mxCell id="client" value="Consumer Client&#10;(Conversational Service Workspace)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;strokeWidth=2;fontStyle=1;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Apigee detail -->
        <mxCell id="apigeeBox" value="Apigee X — API Proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;strokeWidth=2;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="apigeeDetail" value="• TLS termination (TLS 1.2+)&#10;• Proxy: envoy-ingestion-proxy rev N&#10;• AuthN: API key + JWT (OAuth2 IdP)&#10;• Policies: Quota 1000/min, SpikeArrest 20ps&#10;• Target: Private Service Connect (PSC) endpoint&#10;• API product: envoy-golden-path-v1" style="text;html=1;fontSize=10;align=left;fontColor=#0d47a1;" vertex="1" parent="1">
          <mxGeometry x="48" y="235" width="245" height="100" as="geometry" />
        </mxCell>

        <!-- Network container -->
        <mxCell id="vpc" value="VPC: prod-envoy-vpc  (region: us-central1 / equivalent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#212121;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="90" width="1260" height="700" as="geometry" />
        </mxCell>

        <mxCell id="subnet" value="Subnet: gke-subnet-prod  10.20.0.0/22  (secondary: pods 10.20.16.0/20, svc 10.20.32.0/22)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#33691e;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="900" height="450" as="geometry" />
        </mxCell>

        <mxCell id="psc" value="Private Service Connect Endpoint&#10;10.20.0.10 : 443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;strokeWidth=2;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="160" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ilb" value="Internal LB / GKE Gateway&#10;10.20.0.20 : 443 → :8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="160" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="fw" value="Firewall rules:&#10;allow 443 from Apigee PSC range only&#10;deny-all default egress except Cloud SQL, Secret Manager, logging APIs" style="text;html=1;fontSize=10;align=left;fontColor=#616161;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="930" y="160" width="330" height="55" as="geometry" />
        </mxCell>

        <!-- K8s Service -->
        <mxCell id="k8ssvc" value="Service: envoy-api-svc (ClusterIP)&#10;port 80 → targetPort 8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="260" height="55" as="geometry" />
        </mxCell>

        <!-- HPA -->
        <mxCell id="hpa" value="HorizontalPodAutoscaler&#10;min 2 / max 6 replicas, target CPU 70%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="240" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- Deployment -->
        <mxCell id="deploy" value="Deployment: envoy-ingestion-api&#10;strategy: RollingUpdate (maxSurge 1, maxUnavailable 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;strokeWidth=2;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="310" width="580" height="55" as="geometry" />
        </mxCell>

        <!-- Pod detail box -->
        <mxCell id="podBox" value="Pod spec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#0d47a1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="380" width="580" height="190" as="geometry" />
        </mxCell>
        <mxCell id="container1" value="Container: fastapi-app&#10;image: artifact-registry/.../envoy-api:sha&#10;port 8080 · requests 250m/256Mi · limits 500m/512Mi&#10;readiness /healthz · liveness /livez" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90caf9;strokeColor=#0d47a1;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="415" y="410" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="container2" value="Sidecar: cloud-sql-proxy&#10;port 5432 (localhost only)&#10;requests 100m/128Mi · limits 200m/256Mi&#10;connects via Private IP + IAM auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90caf9;strokeColor=#0d47a1;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="410" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sa" value="ServiceAccount: ksa-envoy-ingestion&#10;annotation: iam.gke.io/gcp-service-account=envoy-ingestion@PROJECT.iam.gserviceaccount.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#b71c1c;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="415" y="500" width="555" height="55" as="geometry" />
        </mxCell>

        <!-- GKE node pool -->
        <mxCell id="nodepool" value="Node Pool: prod-pool-1&#10;machine: e2-standard-4 · autoscaling 1–5 nodes · shielded VM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;dashed=1;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="580" width="580" height="30" as="geometry" />
        </mxCell>

        <!-- IAM roles panel -->
        <mxCell id="iamPanel" value="GSA: envoy-ingestion@PROJECT.iam  — bound roles:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#b71c1c;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1310" y="130" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="iamRoles" value="• roles/cloudsql.client&#10;• roles/secretmanager.secretAccessor&#10;• roles/logging.logWriter&#10;• roles/monitoring.metricWriter&#10;(least privilege — no project-level Editor/Owner)" style="text;html=1;fontSize=10;align=left;fontColor=#b71c1c;" vertex="1" parent="1">
          <mxGeometry x="1320" y="165" width="270" height="105" as="geometry" />
        </mxCell>

        <!-- Cloud SQL detail -->
        <mxCell id="cloudsqlBox" value="Cloud SQL — PostgreSQL 15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="640" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cloudsqlDetail" value="• Instance: envoy-ingestion-db (private IP 10.20.40.5)&#10;• HA: regional (primary + standby)&#10;• Automated backups + PITR, 7-day retention&#10;• Max connections: 200 (pooled via proxy)" style="text;html=1;fontSize=10;align=left;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="410" y="680" width="310" height="85" as="geometry" />
        </mxCell>

        <!-- Secret Manager detail -->
        <mxCell id="secretBox" value="Secret Manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="640" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="secretDetail" value="• db-credentials (latest version, auto-rotated)&#10;• api-keys-envoy&#10;• Mounted as env vars via CSI driver / Workload Identity&#10;• Access logged and alertable" style="text;html=1;fontSize=10;align=left;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="770" y="680" width="310" height="85" as="geometry" />
        </mxCell>

        <!-- Observability panel -->
        <mxCell id="obsBox" value="Cloud Logging &amp; Monitoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2ebf2;strokeColor=#00838f;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="640" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="obsDetail" value="• Structured JSON logs (request_id, latency_ms, status)&#10;• Alert policies: p95 latency &gt; 500ms, 5xx rate &gt; 2%, DB conns &gt; 80%&#10;• Dashboards: request rate, error rate, pod restarts&#10;• Log-based metrics feed alerting" style="text;html=1;fontSize=10;align=left;fontColor=#006064;" vertex="1" parent="1">
          <mxGeometry x="1130" y="680" width="460" height="85" as="geometry" />
        </mxCell>

        <!-- CI/CD pipeline (bottom, outside VPC) -->
        <mxCell id="cicdBox" value="Harness CI/CD Pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#6a1b9a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="1580" height="130" as="geometry" />
        </mxCell>
        <mxCell id="stage1" value="1. Build&#10;docker build&#10;unit tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="870" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage2" value="2. Scan&#10;container image scan&#10;SAST/dependency check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="870" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage3" value="3. Push&#10;Artifact Registry&#10;tag: git-sha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="870" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage4" value="4. Terraform apply&#10;infra/network/IAM&#10;plan reviewed pre-merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="870" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage5" value="5. Deploy&#10;rolling update to GKE&#10;manual approval gate (prod)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1100" y="870" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage6" value="6. Verify / Rollback&#10;health check post-deploy&#10;auto-rollback on failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1360" y="870" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#455a64;strokeWidth=2;" edge="1" parent="1" source="client" target="apigeeBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;strokeWidth=2;" edge="1" parent="1" source="apigeeBox" target="psc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;strokeWidth=2;" edge="1" parent="1" source="psc" target="ilb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;strokeWidth=2;" edge="1" parent="1" source="ilb" target="k8ssvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;strokeWidth=2;" edge="1" parent="1" source="k8ssvc" target="deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="scales" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#f57f17;strokeWidth=2;dashed=1;" edge="1" parent="1" source="hpa" target="deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0d47a1;strokeWidth=2;" edge="1" parent="1" source="deploy" target="podBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="binds via Workload Identity" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#b71c1c;strokeWidth=2;" edge="1" parent="1" source="sa" target="iamPanel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="Private IP + IAM auth" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#e65100;strokeWidth=2;" edge="1" parent="1" source="container2" target="cloudsqlBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="mounted secrets" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#e65100;strokeWidth=2;" edge="1" parent="1" source="container1" target="secretBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="logs/metrics" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#00838f;strokeWidth=2;" edge="1" parent="1" source="podBox" target="obsBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="deploys" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#6a1b9a;strokeWidth=2;" edge="1" parent="1" source="cicdBox" target="deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
