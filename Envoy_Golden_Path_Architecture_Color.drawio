<mxfile host="app.diagrams.net">
  <diagram name="Envoy Golden Path - Detailed Color Architecture">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Envoy Golden Path — Ingestion API Platform Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Apigee-managed API ingress · GKE-hosted FastAPI runtime · Cloud SQL persistence · Secret Manager · Workload Identity · Harness CI/CD" style="text;html=1;fontSize=12;fontColor=#616161;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1000" height="20" as="geometry" />
