          <mxGeometry x="40" y="360" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="logging" value="Cloud Logging &amp; Monitoring&#10;Structured app logs&#10;API metrics and alerts" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1f5fe;strokeColor=#6c9ebf;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="530" width="220" height="100" as="geometry" />
