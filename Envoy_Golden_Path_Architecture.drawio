<mxfile host="app.diagrams.net">
  <diagram name="Envoy Golden Path - Ingestion API">
    <mxGraphModel dxNamespace="0" dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Envoy Golden Path -- Ingestion API Platform Architecture" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Apigee-managed API ingress, GKE-hosted FastAPI runtime, Cloud SQL persistence, Secret Manager, Workload Identity, Harness CI/CD" style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="900" height="20" as="geometry" />
        </mxCell>

        <!-- Left column boxes -->
        <mxCell id="pipeline" value="Envoy Golden Path Pipeline&#10;Conversational Service Workspace / IDP&#10;Internal API consumer" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="apigee" value="Apigee API Proxy&#10;AuthN/AuthZ, API key/JWT&#10;Quota, spike arrest, analytics" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
